# ═══════════════════════════════════════════════════════════
#  Real-Time Ride Dispatch System — Environment Config
#  Copy this to .env and fill in your AWS credentials if needed
# ═══════════════════════════════════════════════════════════

# ── AWS Credentials (optional — project runs fine without these) ───────────
# If you have AWS credentials, fill them in to enable real SNS publishing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── AWS SNS Topic (from santosharron's backend) ───────────────────────────
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000876600788:driver-location-topic

# ── API Gateway URL (original santosharron endpoint) ─────────────────────
AWS_API_GATEWAY=https://pvmpz4oexb.execute-api.us-east-1.amazonaws.com/dispatch

# ── Local API URL (used by frontend when running locally) ─────────────────
VITE_API_URL=http://localhost:8000

# ── Ports ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
JENKINS_PORT=9090
